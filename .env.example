# Copy to .env and fill in what you need:  copy .env.example .env
# .env is gitignored. Never commit real keys.
#
# The app picks a generation provider in this order (src/llm.py):
#   1. Groq            if GROQ_API_KEY is set
#   2. HuggingFace     if HF_TOKEN / HUGGINGFACEHUB_API_TOKEN is set
#   3. Llama API       if LLAMA_API_KEY is set
#   4. Local fallback  otherwise (downloads and runs on CPU - slow, dev only)
# A blank value counts as unset, so leave unused providers empty.

# ---------------------------------------------------------------------------
# Generation provider - pick ONE
# ---------------------------------------------------------------------------

# Groq (recommended). Key from https://console.groq.com/keys
GROQ_API_KEY=
# Default: openai/gpt-oss-20b
# The free tier allows 8,000 tokens/minute AND 200,000 tokens/day. One agent
# question costs roughly 24,000 tokens across its five model calls, so the free
# tier is good for about 8 questions per day - see the README's token budget
# section before running the agent eval.
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# HuggingFace Router. Token from https://huggingface.co/settings/tokens
# HUGGINGFACEHUB_API_TOKEN is accepted as an alias for HF_TOKEN.
HF_TOKEN=
HUGGINGFACEHUB_API_TOKEN=
HF_CHAT_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Llama API
LLAMA_API_KEY=
LLAMA_CHAT_MODEL=llama-3.3-70b-instruct

# Used only when no provider key above is set. Runs locally on CPU and is very
# slow; it exists so the app still starts without credentials.
LOCAL_FALLBACK_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Read by src/config.py at import time for a startup credential check.
# Not used for generation.
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Evaluation - optional, only for evals/langsmith_eval.py
# ---------------------------------------------------------------------------

# Free key from https://smith.langchain.com -> Settings -> API Keys.
# LANGCHAIN_API_KEY is accepted as an alias.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=bihar-insights
# Set true to trace agent runs (tool loop + per-call token usage) in the UI.
# evals/langsmith_eval.py turns this on for its own runs regardless.
LANGSMITH_TRACING=false

# evals/run_eval.py needs no keys beyond the generation provider.

# ---------------------------------------------------------------------------
# Notes
# ---------------------------------------------------------------------------

# The frontend reads NEXT_PUBLIC_API_ORIGIN, which belongs in
# frontend/.env.local rather than this file. It defaults to
# http://127.0.0.1:8001 in frontend/next.config.ts, so you only need to set it
# if the backend runs somewhere else.
